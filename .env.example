# Değerix yerel ayarları. Bu dosya git'e gönderilmez.
# TCMB EVDS API anahtarınızı eşittir işaretinin sağına, tırnak ve boşluk olmadan yapıştırın:
EVDS_API_KEY=

# İsteğe bağlı. Tapusor v2 ilan duyuruları erişimi olan sunucu hesabı.
TAPUSOR_CLIENT_ID=
TAPUSOR_CLIENT_SECRET=
TAPUSOR_REQUESTS_PER_HOUR=60
